function reassamble_dust_results(folder1,folder2,fname0)
%% reassemble 
disp('reassembling dust trajectories')
fname1=dir([folder1,fname0,'*']);
ktot=length(fname1);
for k=1:ktot 
load([fname1(k).folder,'/',fname1(k).name])
lll(k)=length(R);
end
R1=zeros(ktot,max(lll)).*NaN; Z1=R1; phi1=R1; vphi1=R1; vZ1=R1; vR1=R1; Mu1=R1;
Nd1=zeros(ktot,max(lll),size(Nd,2)).*NaN;  Td1=R1; Ted1=R1; Tau1=R1;Chi1=R1;
Md1=zeros(ktot,max(lll),3).*NaN; Ed1=Md1; t1=R1;
dead1=(1:ktot).*NaN;
Rho_d1=R1; Cp1=R1;
for k=1:ktot 
    clear t
	load([fname1(k).folder,'/',fname1(k).name])
R1(k,1:length(R))=R; Z1(k,1:length(R))=Z; phi1(k,1:length(R))=phi;
vR1(k,1:length(R))=vR; vZ1(k,1:length(R))=vZ; vphi1(k,1:length(R))=vphi;
Mu1(k,1:length(R))=Mu; Td1(k,1:length(R))=Td; Chi1(k,1:length(R))=Chi;
Nd1(k,1:length(R),:)=Nd; Ted1(k,1:length(R))=Ted; Tau1(k,1:length(R))=Tau;
Md1(k,1:length(R),:)=Md; 
Ed1(k,1:length(R),:)=Ed; 
t1(k,1:length(R))=t;
dead1(k)=dead;
Rho_d1(k,1:length(R))=Rho_d;
Cp1(k,1:length(R))=Cp;
end
R=R1; Z=Z1; phi=phi1;
vR=vR1; vZ=vZ1; vphi=vphi1;
Mu=Mu1; Td=Td1; Chi=Chi1;
Nd=Nd1; Md=Md1; Ed=Ed1;
Ted=Ted1; Tau=Tau1; t=t1;
dead=dead1; Cp=Cp1; Rho_d=Rho_d1;
clear R1 Z1 phi1 vphi1 vZ1 vR1 Mu1 Nd1 Md1 Td1 Ted1 Tau1 Chi1 Ed1 t1 dead1 Cp1 Rho_d1
fnameout=[folder2,fname0,'.mat'];
save(fnameout,'-v7.3')
disp(['file saved in ',fnameout])
